# ── Database (free tier — no payment until you choose to scale) ────────────────
# Get a free Postgres in ~2 min at https://neon.tech or https://supabase.com
# (no credit card required). Copy the connection string here.
# Leave BLANK to use the local-file fallback (.data/*.json) for dev.
DATABASE_URL=

# Token that guards /admin and /api/admin/* — set to a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# ── Email ──────────────────────────────────────────────────────────────────────
# Two options (Gmail is preferred — no domain verification needed):
#
# Option A — Gmail SMTP (recommended). Sends FROM your Gmail to anyone.
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Create an App Password at myaccount.google.com/apppasswords.
#   3. Put the 16-char password in GMAIL_APP_PASSWORD (spaces optional).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Chowby Didi Haus
#
# Option B — Resend (needs a verified sending domain + SPF/DKIM DNS records).
RESEND_API_KEY=
# MAIL_FROM=Chowby Didi Haus <hello@chowbydidihaus.com>
#
# Where enquiry/receipt notifications are sent:
DIDI_EMAIL=chef@chowbydidihaus.com

# ── Bank transfer details (shown publicly on the site) ────────────────────────
NEXT_PUBLIC_BANK_NAME=Providus Bank
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Chowby Didi Haus
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Click-to-chat (wa.me) uses this number — international format.
WHATSAPP_NUMBER=+2348000000000
# Optional: WhatsApp Cloud API for team notifications (free tier).
# Create an app at developers.facebook.com → WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=2348000000000
# Optional approved template name (needed for messages outside the 24h window).
WHATSAPP_TEMPLATE=

# ── Slack alerts (optional, free Incoming Webhook) ────────────────────────────
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── SEO / Analytics ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://chowbydidihaus.com
# Optional privacy-friendly analytics — set your domain to enable Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Card payments: DISABLED for now (bank transfer + receipt upload only) ──────
# Re-enable later by adding your Paystack keys here and wiring a checkout flow.
# NEXT_PUBLIC_PAYSTACK_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
